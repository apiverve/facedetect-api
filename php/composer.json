    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "facedetect",
        "face detection api",
        "face detector api",
        "free face detection api",
        "api face detection",
        "detect faces in image"
    ],
    "homepage": "https://apiverve.com/marketplace/facedetect?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/facedetect",
        "source": "https://github.com/apiverve/facedetect-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Facedetect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Facedetect\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
